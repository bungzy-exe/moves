# Copy this file to server/.env and fill in the values.
# server/.env is ignored by git. Never commit real values.

# Port for the local Express server. The Vite proxy expects 3000.
PORT=3000

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Replace <username> and <password> with a database user, not your Atlas login.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database inside the cluster. Use moves_dev locally; production gets moves_prod.
# Tests always use moves_test.
MONGODB_DB_NAME=moves_dev
